# ---------------------------------------------------------------------------
# Copy to .env and fill ONE provider. After changing the embedding provider,
# rebuild the index:  python -m insurex_agent.ingestion.build_index
# ---------------------------------------------------------------------------

# Option A - OpenAI (default)
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=sk-...

# Option B - Google Gemini (free tier available at https://aistudio.google.com/apikey)
# LLM_PROVIDER=google_genai
# LLM_MODEL=gemini-flash-latest
# EMBEDDING_PROVIDER=google_genai
# EMBEDDING_MODEL=models/gemini-embedding-001
# GOOGLE_API_KEY=...

# Option C - Anthropic for the LLM (pair with OpenAI/Gemini/local embeddings)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=...

# Option D - fully local with Ollama (ollama pull qwen3:8b && ollama pull bge-m3)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=bge-m3

# Option E - no keys at all (rule-based brain + offline LSA embeddings; for tests/CI)
# LLM_PROVIDER=offline
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=lsa-256

# --- behaviour (defaults shown) ---
# LEADS_BACKEND=mcp            # mcp = call the MCP server over stdio; direct = in-process (tests)
# VERIFY_WITH_LLM=true         # LLM fact-check on top of the deterministic number check
# SECTION_BOOSTS=false        # metadata boosts; off by default (see eval/results)
# MAX_RETRIEVAL_ATTEMPTS=2
# MAX_GENERATION_ATTEMPTS=2
# HISTORY_WINDOW=8
# SUMMARIZE_AFTER=16
# LOG_LEVEL=INFO

# Optional tracing in LangSmith
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=...
